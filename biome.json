{
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "client/src/**",
      "client/tests/**",
      "client/scripts/**",
      "client/vite.config.ts",
      "server/src/**",
      "server/test/**",
      "server/scripts/**",
      "shared/src/**",
      "shared/test/**",
      "shared/scripts/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "useLiteralKeys": "off",
        "noCommaOperator": "off",
        "useOptionalChain": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noImplicitAnyLet": "off",
        "noSelfCompare": "off",
        "noUnsafeDeclarationMerging": "off"
      },
      "correctness": {
        "noVoidTypeReturn": "off",
        "useYield": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
