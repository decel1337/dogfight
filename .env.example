# Скопіюйте в .env (він у .gitignore) і змініть за потреби.
# Усі змінні читає ОДИН модуль — server/src/config.ts (zod-схема, значення за замовчуванням там).

# --- мережа ---
PORT=3000
# 127.0.0.1 локально; в контейнері Dockerfile ставить 0.0.0.0
HOST=127.0.0.1

# --- логи й метрики ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
ENABLE_METRICS=1
LOG_DIR=logs

# --- безпека (Lab 8) ---
# Origin-и, яким дозволено відкривати WebSocket (через кому). Порожньо = лише same-origin.
ALLOWED_ORIGINS=
MAX_CONNECTIONS_PER_IP=20
# 1 лише за довіреним reverse proxy (Fly, nginx): тоді IP береться з X-Forwarded-For.
TRUST_PROXY=0

# --- версія збірки (в образі підставляється з git SHA) ---
GIT_SHA=dev
APP_VERSION=0.0.0

# --- ігрові ліміти ---
MAX_ROOMS=50
MAX_PLAYERS_PER_ROOM=8
SHUTDOWN_TIMEOUT_MS=5000
