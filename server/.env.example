# Скопіюйте в .env (файл у .gitignore). Усе, що не задано, має значення за замовчуванням.
PORT=3000
HOST=127.0.0.1
LOG_DIR=./logs
# Каталог зібраного клієнта (npm run build):
# STATIC_DIR=../client/dist

# Ліміти (Lab 04, M4)
MAX_ROOMS=50
MAX_PLAYERS_PER_ROOM=8
MAX_PAYLOAD=2048
MAX_BODY_BYTES=4096
RATE_PER_SEC=10
RATE_BURST=20
BUFFERED_LIMIT=1048576

# Тільки для демо event loop: вмикає /api/slow та /api/slow-async
ENABLE_DEBUG_ROUTES=0
